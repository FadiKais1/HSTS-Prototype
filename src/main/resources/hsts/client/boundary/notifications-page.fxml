<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.NotificationsPage"
            prefWidth="1080" prefHeight="720"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
            <VBox spacing="3">
                <Label text="Notifications"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="identityLabel" text="Authenticated user"
                       style="-fx-text-fill: #475569;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
            <Button fx:id="backButton" text="Back" onAction="#handleBack"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="22" bottom="22" left="22"/></padding>
            <Label fx:id="statusLabel" text="Loading notifications..." wrapText="true"
                   style="-fx-background-color: #eff6ff; -fx-text-fill: #1e40af; -fx-padding: 9;"/>
            <TableView fx:id="notificationTable" prefHeight="390" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="stateColumn" text="State" prefWidth="85"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="165"/>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="390"/>
                    <TableColumn fx:id="createdColumn" text="Created" prefWidth="180"/>
                </columns>
                <placeholder><Label text="No notifications."/></placeholder>
            </TableView>
            <Label text="Message" style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
            <TextArea fx:id="messageArea" editable="false" wrapText="true" prefRowCount="5"
                      style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
        </VBox>
    </center>
</BorderPane>
