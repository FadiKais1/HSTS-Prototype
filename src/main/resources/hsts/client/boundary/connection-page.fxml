<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="hsts.client.boundary.ConnectionPage"
           prefWidth="900" prefHeight="620"
           style="-fx-background-color: #f4f7fb;">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox alignment="CENTER_LEFT" spacing="14" maxWidth="420"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #dbe3ef; -fx-border-radius: 16; -fx-padding: 34;">
        <Label text="HSTS Exam Management System"
               wrapText="true"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Label text="Connect to the HSTS server"
               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>

        <Label text="Server host or IP address"
               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="hostField"
                   promptText="e.g. 192.168.1.20 or localhost"
                   prefHeight="42"
                   onAction="#handleConnect"/>

        <Label text="Server port"
               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="portField"
                   promptText="5555"
                   prefHeight="42"
                   onAction="#handleConnect"/>

        <Label fx:id="statusLabel"
               text=""
               managed="false"
               visible="false"
               wrapText="true"
               maxWidth="Infinity"
               style="-fx-background-color: #eff6ff; -fx-background-radius: 8; -fx-text-fill: #1d4ed8; -fx-padding: 9;"/>

        <Label fx:id="errorLabel"
               text=""
               managed="false"
               visible="false"
               wrapText="true"
               maxWidth="Infinity"
               style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-text-fill: #b91c1c; -fx-padding: 9;"/>

        <Button fx:id="connectButton"
                text="Connect"
                defaultButton="true"
                maxWidth="Infinity"
                prefHeight="44"
                onAction="#handleConnect"
                style="-fx-background-color: #2563eb; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
