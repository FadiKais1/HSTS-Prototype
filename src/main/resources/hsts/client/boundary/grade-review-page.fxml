<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.GradeReviewPage"
            prefWidth="1100" prefHeight="720"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <VBox spacing="3">
                <Label text="Grade Review"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <HBox spacing="8">
                    <Label fx:id="userLabel" text="Authenticated manager"
                           style="-fx-text-fill: #4b5563;"/>
                    <Label text="·" style="-fx-text-fill: #9ca3af;"/>
                    <Label fx:id="roleLabel" text="TEACHER"
                           style="-fx-text-fill: #7c3aed; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="busyIndicator" prefWidth="26" prefHeight="26"
                               managed="false" visible="false"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
                    style="-fx-background-color: #e5e7eb; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 9 15;"/>
            <Button fx:id="backButton" text="Back" onAction="#handleBack"
                    style="-fx-background-color: #374151; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 15;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="16" right="18" bottom="18" left="18"/></padding>
            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 14;">
                <Label text="Managed exam execution" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="executionComboBox" maxWidth="Infinity"
                          promptText="No managed execution selected"/>
            </VBox>

            <SplitPane dividerPositions="0.43" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="8" style="-fx-padding: 10;">
                        <Label text="Submissions"
                               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <TableView fx:id="submissionTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="studentColumn" text="Student" prefWidth="125"/>
                                <TableColumn fx:id="studentIdColumn" text="User" prefWidth="58"/>
                                <TableColumn fx:id="submissionIdColumn" text="Submission" prefWidth="76"/>
                                <TableColumn fx:id="submissionStatusColumn" text="Status" prefWidth="92"/>
                                <TableColumn fx:id="submittedColumn" text="Submitted" prefWidth="122"/>
                                <TableColumn fx:id="automaticScoreColumn" text="Auto" prefWidth="55"/>
                                <TableColumn fx:id="finalScoreColumn" text="Final" prefWidth="55"/>
                                <TableColumn fx:id="reviewedColumn" text="Reviewed" prefWidth="122"/>
                                <TableColumn fx:id="publishedColumn" text="Published" prefWidth="122"/>
                            </columns>
                            <placeholder><Label text="No submissions for this execution."/></placeholder>
                        </TableView>
                    </VBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox spacing="10" style="-fx-padding: 12;">
                                <Label text="Submission details"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                                <HBox spacing="7">
                                    <Label text="Exam:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="examTitleValue" text="-" wrapText="true"/>
                                </HBox>
                                <HBox spacing="7">
                                    <Label text="Student:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="studentValue" text="-" wrapText="true"/>
                                </HBox>
                                <HBox spacing="7">
                                    <Label text="Status:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="detailStatusValue" text="-"/>
                                    <Label text="Automatic score:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="automaticScoreValue" text=""/>
                                </HBox>
                                <Label fx:id="timestampsValue" text="" wrapText="true"
                                       style="-fx-text-fill: #6b7280;"/>
                                <Separator/>
                                <Label text="Ordered answers" style="-fx-font-weight: bold;"/>
                                <TableView fx:id="answerTable" prefHeight="210">
                                    <columns>
                                        <TableColumn fx:id="answerOrderColumn" text="#" prefWidth="38"/>
                                        <TableColumn fx:id="questionColumn" text="Question" prefWidth="235"/>
                                        <TableColumn fx:id="selectedAnswerColumn" text="Submitted answer" prefWidth="130"/>
                                        <TableColumn fx:id="correctnessColumn" text="Result" prefWidth="85"/>
                                        <TableColumn fx:id="awardedColumn" text="Awarded" prefWidth="65"/>
                                        <TableColumn fx:id="maximumColumn" text="Max" prefWidth="55"/>
                                    </columns>
                                    <placeholder><Label text="Select a submission to inspect its answers."/></placeholder>
                                </TableView>
                                <VBox fx:id="questionIllustrationContainer" spacing="6"
                                      visible="false" managed="false">
                                    <Label text="Selected submitted question illustration"
                                           style="-fx-font-weight: bold;"/>
                                    <ImageView fx:id="questionIllustrationView" fitWidth="520"
                                               fitHeight="320" preserveRatio="true"
                                               visible="false" managed="false"/>
                                    <Label fx:id="questionIllustrationErrorLabel"
                                           text="Question illustration is unavailable"
                                           style="-fx-text-fill: #6b7280;"
                                           visible="false" managed="false"/>
                                </VBox>
                                <Label text="Final score" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="finalScoreField" promptText="0.00 to 100.00"/>
                                <Label text="Teacher feedback" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="feedbackArea" prefRowCount="2" wrapText="true"/>
                                <Label text="Adjustment reason" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="adjustmentReasonArea" prefRowCount="2" wrapText="true"
                                          promptText="Required when final score differs from automatic score"/>
                                <HBox spacing="10">
                                    <Button fx:id="saveReviewButton" text="Save Review"
                                            onAction="#handleSaveReview"
                                            style="-fx-background-color: #2563eb; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 15;"/>
                                    <Button fx:id="publishGradeButton" text="Publish Grade"
                                            onAction="#handlePublishGrade"
                                            style="-fx-background-color: #059669; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 15;"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </items>
            </SplitPane>

            <Label fx:id="statusLabel" text="Select an execution to begin." wrapText="true"
                   maxWidth="Infinity"
                   style="-fx-background-color: #eef2ff; -fx-background-radius: 8; -fx-text-fill: #3730a3; -fx-padding: 9;"/>
        </VBox>
    </center>
</BorderPane>
