<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.ReportsPage"
            prefWidth="1180" prefHeight="760"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <padding><Insets top="15" right="22" bottom="15" left="22"/></padding>
            <VBox spacing="3">
                <Label text="Reports"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="roleContextLabel" text="Authenticated report context"
                       style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="loadingIndicator" managed="false" visible="false"
                               prefWidth="28" prefHeight="28" maxWidth="28" maxHeight="28"/>
            <Button fx:id="exportPdfButton" text="Export PDF" onAction="#handleExportPdf"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 15;"/>
            <Button fx:id="exportExcelButton" text="Export Excel" onAction="#handleExportExcel"
                    style="-fx-background-color: #15803d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 15;"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
                    style="-fx-background-color: #e0f2fe; -fx-text-fill: #075985; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 15;"/>
            <Button fx:id="backButton" text="Back" onAction="#handleBack"
                    style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 15;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" pannable="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="14">
                    <padding><Insets top="18" right="22" bottom="24" left="22"/></padding>

                    <HBox fx:id="principalControls" alignment="CENTER_LEFT" spacing="10"
                          managed="false" visible="false"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 14;">
                        <Label text="Comparison:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="comparisonModeComboBox" prefWidth="150"/>
                        <Label text="Target:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="targetComboBox" prefWidth="300"
                                  promptText="Choose a teacher, course, student or execution"/>
                        <Button fx:id="loadButton" text="Load Report" onAction="#handleLoadReport"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 16;"/>
                    </HBox>

                    <Label fx:id="errorLabel" text="" managed="false" visible="false"
                           wrapText="true" maxWidth="Infinity"
                           style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-text-fill: #b91c1c; -fx-padding: 9;"/>
                    <Label fx:id="statusLabel" text="Reports page is not configured"
                           wrapText="true" maxWidth="Infinity"
                           style="-fx-background-color: #eff6ff; -fx-background-radius: 8; -fx-text-fill: #1e40af; -fx-padding: 9;"/>

                    <GridPane hgap="18" vgap="7"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 14;">
                        <Label text="Report" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="reportTitleLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Target" GridPane.rowIndex="0" GridPane.columnIndex="2"
                               style="-fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="targetNameLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="3"
                               style="-fx-text-fill: #111827;"/>
                        <Label text="Generated" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="generatedAtLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               style="-fx-text-fill: #111827;"/>
                        <Label text="Executions" GridPane.rowIndex="1" GridPane.columnIndex="2"
                               style="-fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="executionCountLabel" text="0" GridPane.rowIndex="1" GridPane.columnIndex="3"
                               style="-fx-text-fill: #111827;"/>
                    </GridPane>

                    <Label text="Execution Statistics"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <TableView fx:id="executionTable" prefHeight="250">
                        <placeholder><Label text="No execution statistics in this report"/></placeholder>
                        <columns>
                            <TableColumn fx:id="executionCodeColumn" text="Code" prefWidth="75"/>
                            <TableColumn fx:id="examTitleColumn" text="Exam" prefWidth="145"/>
                            <TableColumn fx:id="courseNameColumn" text="Course" prefWidth="115"/>
                            <TableColumn fx:id="openingTimeColumn" text="Opening" prefWidth="135"/>
                            <TableColumn fx:id="closingTimeColumn" text="Closing" prefWidth="135"/>
                            <TableColumn fx:id="publishedCountColumn" text="Published" prefWidth="75"/>
                            <TableColumn fx:id="averageScoreColumn" text="Average" prefWidth="70"/>
                            <TableColumn fx:id="medianScoreColumn" text="Median" prefWidth="70"/>
                            <TableColumn fx:id="startedCountColumn" text="Started" prefWidth="65"/>
                            <TableColumn fx:id="submittedCountColumn" text="Submitted" prefWidth="75"/>
                            <TableColumn fx:id="autoSubmittedCountColumn" text="Auto" prefWidth="60"/>
                        </columns>
                    </TableView>

                    <HBox spacing="16" alignment="TOP_LEFT">
                        <VBox fx:id="detailContainer" spacing="9" prefWidth="410" minWidth="350"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 16;">
                            <Label text="Selected Execution"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Separator/>
                            <Label fx:id="detailPromptLabel" text="Select an execution to view details"
                                   wrapText="true" managed="true" visible="true"
                                   style="-fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                            <GridPane fx:id="detailContent" hgap="12" vgap="7"
                                      managed="false" visible="false"
                                      style="-fx-text-fill: #111827; -fx-opacity: 1;">
                                <Label fx:id="detailCodeCaption" text="Code" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailExecutionCodeLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailExamCaption" text="Exam" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailExamTitleLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailVersionCaption" text="Version" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailVersionLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailCourseCaption" text="Course" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailCourseLabel" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailOpeningCaption" text="Opening" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailOpeningLabel" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailClosingCaption" text="Closing" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailClosingLabel" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailPublishedCaption" text="Published Results" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailPublishedLabel" text="-" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailAverageCaption" text="Average" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailAverageLabel" text="-" GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailMedianCaption" text="Median" GridPane.rowIndex="8" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailMedianLabel" text="-" GridPane.rowIndex="8" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailStartedCaption" text="Started" GridPane.rowIndex="9" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailStartedLabel" text="-" GridPane.rowIndex="9" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailSubmittedCaption" text="Submitted" GridPane.rowIndex="10" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailSubmittedLabel" text="-" GridPane.rowIndex="10" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="detailAutoSubmittedCaption" text="Auto-submitted" GridPane.rowIndex="11" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4b5563; -fx-opacity: 1;"/>
                                <Label fx:id="detailAutoSubmittedLabel" text="-" GridPane.rowIndex="11" GridPane.columnIndex="1" style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                            </GridPane>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 12;">
                            <Label text="Published Score Distribution"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <BarChart fx:id="scoreBandChart" title="Ten score bands"
                                      animated="false" legendVisible="false"
                                      categoryGap="4" barGap="1" prefHeight="330" VBox.vgrow="ALWAYS">
                                <xAxis><CategoryAxis fx:id="scoreBandAxis" label="Score band" tickLabelRotation="-35"
                                                     tickLabelFill="#374151" opacity="1.0"
                                                     style="-fx-tick-label-fill: #374151; -fx-text-fill: #374151; -fx-opacity: 1;"/></xAxis>
                                <yAxis><NumberAxis fx:id="submissionCountAxis" label="Published submissions"
                                                  autoRanging="false" lowerBound="0" upperBound="1" tickUnit="1"
                                                  forceZeroInRange="true" minorTickVisible="false"
                                                  tickLabelFill="#374151" opacity="1.0"
                                                  style="-fx-tick-label-fill: #374151; -fx-text-fill: #374151; -fx-opacity: 1;"/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
