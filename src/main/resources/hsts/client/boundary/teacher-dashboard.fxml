<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.TeacherDashboard"
            prefWidth="1000" prefHeight="680"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <padding><Insets top="18" right="26" bottom="18" left="26"/></padding>
            <VBox spacing="4">
                <Label fx:id="welcomeLabel" text="Welcome"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="roleLabel" text="TEACHER"
                       style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton" text="Log Out" onAction="#handleLogout"
                    style="-fx-background-color: #e5e7eb; -fx-background-radius: 8; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-padding: 9 16;"/>
        </HBox>
    </top>
    <center>
        <StackPane>
            <padding><Insets top="34" right="34" bottom="34" left="34"/></padding>
            <VBox alignment="TOP_LEFT" spacing="16" maxWidth="660"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #dbe3ef; -fx-border-radius: 16; -fx-padding: 30;">
                <Label text="Teacher and Coordinator Dashboard"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="Open the working question bank or review upcoming Assignment 3 areas."
                       wrapText="true" style="-fx-text-fill: #6b7280;"/>
                <Label fx:id="errorLabel" text="" managed="false" visible="false"
                       wrapText="true" maxWidth="Infinity"
                       style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-text-fill: #b91c1c; -fx-padding: 9;"/>
                <Button fx:id="questionBankButton" text="Question Bank"
                        onAction="#handleQuestionBank" maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #2563eb; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="examManagementButton" text="Exam Management"
                        onAction="#handleExamManagement" maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #0f766e; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="examSchedulingButton" text="Exam Scheduling"
                        onAction="#handleExamScheduling" maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #b45309; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="gradeReviewButton" text="Review Grades"
                        onAction="#handleGradeReview" maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #be185d; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="approvalRequestsButton" text="Approval Requests" disable="true"
                        managed="false" visible="false" onAction="#handleApprovalRequests"
                        maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #7c3aed; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="reportsButton" text="Reports" onAction="#handleReports"
                        maxWidth="Infinity" prefHeight="46"
                        style="-fx-background-color: #0369a1; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
