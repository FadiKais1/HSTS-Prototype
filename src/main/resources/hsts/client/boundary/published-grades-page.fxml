<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.PublishedGradesPage"
            prefWidth="1180" prefHeight="760"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <VBox spacing="3">
                <Label text="Published Grades"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <HBox spacing="8">
                    <Label fx:id="userLabel" text="Student" style="-fx-text-fill: #4b5563;"/>
                    <Label text="|" style="-fx-text-fill: #9ca3af;"/>
                    <Label fx:id="roleLabel" text="STUDENT"
                           style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="busyIndicator" prefWidth="26" prefHeight="26"
                               visible="false" managed="false"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 9 18;"/>
            <Button fx:id="backButton" text="Back" onAction="#handleBack"
                    style="-fx-background-color: #e5e7eb; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 9 18;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16">
            <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>

            <Label fx:id="statusLabel" text="Published grades will appear here."
                   wrapText="true" maxWidth="Infinity"
                   style="-fx-background-color: #eff6ff; -fx-background-radius: 9; -fx-text-fill: #1e40af; -fx-padding: 11;"/>

            <HBox spacing="18" prefHeight="300" maxHeight="300">
                <VBox spacing="10" prefWidth="690" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #dbe3ef; -fx-border-radius: 14; -fx-padding: 18;">
                    <Label text="My published results"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Select a result to view its published details."
                           style="-fx-text-fill: #6b7280;"/>
                    <TableView fx:id="gradeTable" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No published grades are available."/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="examTitleColumn" text="Exam" prefWidth="180"/>
                            <TableColumn fx:id="courseColumn" text="Course" prefWidth="140"/>
                            <TableColumn fx:id="finalScoreColumn" text="Final Score" prefWidth="90"/>
                            <TableColumn fx:id="submittedColumn" text="Submitted" prefWidth="130"/>
                            <TableColumn fx:id="publishedColumn" text="Published" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="12" prefWidth="390"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #dbe3ef; -fx-border-radius: 14; -fx-padding: 20;">
                    <Label text="Published grade detail"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Separator/>
                    <Label text="Exam" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="detailExamTitleValue" text="-" wrapText="true"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Course" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="detailCourseValue" text="-" wrapText="true"/>
                    <Label text="Final score" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="detailFinalScoreValue" text="-"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                    <Separator/>
                    <Label text="Teacher feedback" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="feedbackArea" editable="false" wrapText="true"
                              prefRowCount="5" promptText="No feedback provided"/>
                    <HBox spacing="8"><Label text="Submitted:"/><Label fx:id="submittedValue"/></HBox>
                    <HBox spacing="8"><Label text="Reviewed:"/><Label fx:id="reviewedValue"/></HBox>
                    <HBox spacing="8"><Label text="Published:"/><Label fx:id="publishedValue"/></HBox>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <VBox spacing="14"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #dbe3ef; -fx-border-radius: 14; -fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3">
                                <Label text="Reviewed exam copy"
                                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #111827; -fx-opacity: 1;"/>
                                <Label fx:id="reviewStatusLabel"
                                       text="Select a published grade to review the exam."
                                       wrapText="true"
                                       style="-fx-text-fill: #475569; -fx-opacity: 1;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="previousQuestionButton" text="Previous question"
                                    onAction="#handlePreviousQuestion" disable="true"
                                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #111827; -fx-font-weight: bold;"/>
                            <Button fx:id="nextQuestionButton" text="Next question"
                                    onAction="#handleNextQuestion" disable="true"
                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                        <Separator/>
                        <HBox spacing="24">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <HBox spacing="7"><Label text="Exam:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewExamValue" text="-" wrapText="true" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Course:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewCourseValue" text="-" wrapText="true" style="-fx-text-fill: #111827; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Execution code:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewExecutionValue" text="-" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Exact version:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewVersionValue" text="-" style="-fx-text-fill: #111827; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Final score:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewFinalScoreValue" text="-" style="-fx-text-fill: #166534; -fx-font-size: 18px; -fx-font-weight: bold; -fx-opacity: 1;"/></HBox>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <HBox spacing="7"><Label text="Submitted:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewSubmittedValue" style="-fx-text-fill: #111827; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Reviewed:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewReviewedValue" style="-fx-text-fill: #111827; -fx-opacity: 1;"/></HBox>
                                <HBox spacing="7"><Label text="Published:" style="-fx-text-fill: #475569;"/><Label fx:id="reviewPublishedValue" style="-fx-text-fill: #111827; -fx-opacity: 1;"/></HBox>
                                <Label text="Published teacher feedback" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                <TextArea fx:id="reviewFeedbackArea" editable="false"
                                          wrapText="true" prefRowCount="2"
                                          style="-fx-text-fill: #111827; -fx-opacity: 1;"/>
                            </VBox>
                        </HBox>
                        <Separator/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="questionPositionLabel" text="No question selected"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827; -fx-opacity: 1;"/>
                            <Label fx:id="questionOutcomeLabel" text=""/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="questionScoreLabel" text=""
                                   style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-opacity: 1;"/>
                        </HBox>
                        <Label fx:id="questionMetadataLabel" text="" wrapText="true"
                               style="-fx-text-fill: #475569; -fx-opacity: 1;"/>
                        <TextArea fx:id="reviewQuestionContentArea" editable="false"
                                  wrapText="true" prefRowCount="3"
                                  style="-fx-text-fill: #111827; -fx-font-size: 15px; -fx-opacity: 1;"/>
                        <VBox fx:id="questionIllustrationContainer" spacing="6"
                              visible="false" managed="false">
                            <ImageView fx:id="questionIllustrationView" fitWidth="520"
                                       fitHeight="320" preserveRatio="true"
                                       visible="false" managed="false"/>
                            <Label fx:id="questionIllustrationErrorLabel"
                                   text="Question illustration is unavailable"
                                   style="-fx-text-fill: #6b7280;"
                                   visible="false" managed="false"/>
                        </VBox>
                        <Label text="Answer options"
                               style="-fx-font-weight: bold; -fx-text-fill: #111827; -fx-opacity: 1;"/>
                        <VBox fx:id="answerOptionsBox" spacing="8"/>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
