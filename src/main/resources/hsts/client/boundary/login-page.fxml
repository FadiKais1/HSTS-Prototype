<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="hsts.client.boundary.LoginPage"
           prefWidth="900" prefHeight="620"
           style="-fx-background-color: #f4f7fb;">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox alignment="CENTER_LEFT" spacing="14" maxWidth="420"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #dbe3ef; -fx-border-radius: 16; -fx-padding: 34;">
        <Label text="HSTS Exam Management System"
               wrapText="true"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Label text="Sign in to continue"
               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>

        <Label text="Email"
               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="emailField"
                   promptText="Email address"
                   prefHeight="42"/>

        <Label text="Password"
               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="42"
                       onAction="#handleLogin"/>

        <Label fx:id="errorLabel"
               text=""
               managed="false"
               visible="false"
               wrapText="true"
               maxWidth="Infinity"
               style="-fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-text-fill: #b91c1c; -fx-padding: 9;"/>

        <Button fx:id="loginButton"
                text="Sign In"
                defaultButton="true"
                maxWidth="Infinity"
                prefHeight="44"
                onAction="#handleLogin"
                style="-fx-background-color: #2563eb; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
