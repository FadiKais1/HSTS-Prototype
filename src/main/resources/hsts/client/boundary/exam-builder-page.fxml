<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hsts.client.boundary.ExamBuilderPage"
            prefWidth="1280" prefHeight="820"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: transparent transparent #dbe3ef transparent;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="14" right="22" bottom="12" left="22"/></padding>
                <VBox spacing="2">
                    <Label text="Exam Builder"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label fx:id="versionStatusLabel" text="New DRAFT exam"
                           style="-fx-text-fill: #64748b;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="newButton" text="New" onAction="#handleNewExam"/>
                <Button fx:id="openButton" text="Open / Edit" onAction="#handleOpenExam"/>
                <Button fx:id="saveAsNewExamButton" text="Save as New Exam"
                        onAction="#handleSaveAsNewExam"/>
                <Button fx:id="saveButton" text="Save Draft" onAction="#handleSaveDraft"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="submitButton" text="Submit for Approval"
                        onAction="#handleSubmitForApproval"
                        style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
                <Button fx:id="questionBankButton" text="Open Question Bank"
                        onAction="#handleOpenQuestionBank"/>
                <Button fx:id="backButton" text="Back" onAction="#handleBack"/>
            </HBox>
            <Label fx:id="statusLabel" text="Waiting for authenticated client." wrapText="true"
                   maxWidth="Infinity"
                   style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-padding: 8 22;"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.30">
            <items>
                <VBox spacing="10" minWidth="330" prefWidth="365"
                      style="-fx-background-color: white; -fx-padding: 16;">
                    <Label text="My Exams"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Select an exam and choose Open / Edit. Server order is preserved."
                           wrapText="true" style="-fx-text-fill: #64748b;"/>
                    <TableView fx:id="examTable" VBox.vgrow="ALWAYS" prefHeight="650">
                        <columns>
                            <TableColumn fx:id="examCodeColumn" text="Code" prefWidth="70"/>
                            <TableColumn fx:id="examTitleColumn" text="Title" prefWidth="120"/>
                            <TableColumn fx:id="examCourseColumn" text="Course" prefWidth="100"/>
                            <TableColumn fx:id="examVersionColumn" text="Ver." prefWidth="46"/>
                            <TableColumn fx:id="examTotalColumn" text="Score" prefWidth="56"/>
                            <TableColumn fx:id="examStatusColumn" text="Status" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
                <ScrollPane fitToWidth="true" pannable="true">
                    <content>
                        <VBox spacing="14" style="-fx-padding: 18; -fx-background-color: #f4f7fb;">
                            <VBox spacing="12"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 16;">
                                <fx:define>
                                    <ToggleGroup fx:id="creationModeGroup"/>
                                </fx:define>
                                <Label fx:id="loadedExamLabel" text="New DRAFT exam"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="Creation mode" style="-fx-font-weight: bold;"/>
                                    <RadioButton fx:id="manualModeRadio" text="Manual" selected="true"
                                                 toggleGroup="$creationModeGroup"
                                                 onAction="#handleManualMode"/>
                                    <RadioButton fx:id="automaticModeRadio" text="Automatic"
                                                 toggleGroup="$creationModeGroup"
                                                 onAction="#handleAutomaticMode"/>
                                    <Label text="Automatic generation is available for new DRAFT exams only."
                                           style="-fx-text-fill: #64748b;"/>
                                </HBox>
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" prefWidth="170"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="150" prefWidth="170"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <!-- Subject narrows the course list, so a teacher who
                                         teaches across subjects picks the subject first. -->
                                    <Label text="Subject" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <ComboBox fx:id="subjectComboBox" maxWidth="Infinity"
                                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Title *" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="titleField" promptText="Exam title"
                                               GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    <Label text="Assigned course *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <ComboBox fx:id="courseComboBox" maxWidth="Infinity"
                                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Teacher-only notes" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <TextArea fx:id="teacherNotesArea" prefRowCount="2" wrapText="true"
                                              GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                    <Label text="Duration (minutes) *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="durationField" promptText="60"
                                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    <Label text="Student instructions *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="studentInstructionsArea" prefRowCount="2" wrapText="true"
                                              GridPane.rowIndex="3" GridPane.columnIndex="1"
                                              GridPane.columnSpan="3"/>
                                </GridPane>
                            </VBox>

                            <VBox fx:id="rejectionReasonPanel" spacing="6"
                                  visible="false" managed="false"
                                  style="-fx-background-color: #fef2f2; -fx-background-radius: 12; -fx-border-color: #ef4444; -fx-border-radius: 12; -fx-padding: 14;">
                                <Label text="Rejection reason"
                                       style="-fx-font-weight: bold; -fx-text-fill: #7f1d1d; -fx-opacity: 1;"/>
                                <Label fx:id="rejectionReasonLabel" text=""
                                       wrapText="true" maxWidth="Infinity"
                                       style="-fx-text-fill: #1f2937; -fx-opacity: 1;"/>
                            </VBox>

                            <VBox fx:id="automaticCriteriaPane" spacing="12"
                                  visible="false" managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #93c5fd; -fx-border-radius: 12; -fx-padding: 16;">
                                <Label text="Automatic Question Criteria"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="The server will select matching ACTIVE questions from the assigned course, preserve their current versions, and assign order and scores totaling 100."
                                       wrapText="true" style="-fx-text-fill: #475569;"/>
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="130" prefWidth="150"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="130" prefWidth="150"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Topic *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="topicField" promptText="For example: Calculus"
                                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Difficulty *" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <ComboBox fx:id="difficultyComboBox" promptText="Select difficulty"
                                              maxWidth="Infinity"
                                              GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    <Label text="Number of questions *"
                                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="questionCountField" promptText="10"
                                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Button fx:id="generateButton" text="Generate Draft"
                                            onAction="#handleGenerateDraft"
                                            GridPane.rowIndex="1" GridPane.columnIndex="3"
                                            maxWidth="Infinity"
                                            style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                </GridPane>

                                <Separator/>

                                <Label text="Breakdown by topic and difficulty"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="Add one line per topic and difficulty. The exam is composed from every line, and the same question is never used twice. Leave the list empty to generate from the single topic above."
                                       wrapText="true" style="-fx-text-fill: #475569;"/>

                                <HBox spacing="8">
                                    <Button fx:id="addCriterionButton" text="Add line"
                                            onAction="#handleAddCriterion"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                    <Button fx:id="removeCriterionButton" text="Remove line"
                                            onAction="#handleRemoveCriterion"
                                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #111827;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="criteriaTotalLabel" text="No breakdown lines"
                                           style="-fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                                </HBox>

                                <TableView fx:id="criteriaTable" prefHeight="150">
                                    <columns>
                                        <TableColumn fx:id="criterionTopicColumn" text="Topic" prefWidth="240"/>
                                        <TableColumn fx:id="criterionDifficultyColumn" text="Difficulty" prefWidth="140"/>
                                        <TableColumn fx:id="criterionCountColumn" text="Questions" prefWidth="110"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <SplitPane fx:id="manualQuestionPane" dividerPositions="0.49" prefHeight="420">
                                <items>
                                    <VBox spacing="8"
                                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 14;">
                                        <Label text="Available ACTIVE Questions"
                                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                                        <Label text="Loaded from the selected assigned course."
                                               style="-fx-text-fill: #64748b;"/>
                                        <TableView fx:id="availableQuestionsTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="availableIdColumn" text="ID" prefWidth="48"/>
                                                <TableColumn fx:id="availableContentColumn" text="Content" prefWidth="245"/>
                                                <TableColumn fx:id="availableTopicColumn" text="Topic" prefWidth="90"/>
                                                <TableColumn fx:id="availableDifficultyColumn" text="Difficulty" prefWidth="80"/>
                                                <TableColumn fx:id="availableVersionColumn" text="Ver." prefWidth="50"/>
                                            </columns>
                                        </TableView>
                                        <Button fx:id="addButton" text="Add Selected Question →"
                                                onAction="#handleAddQuestion" maxWidth="Infinity"
                                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                    </VBox>
                                    <VBox spacing="8"
                                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dbe3ef; -fx-border-radius: 12; -fx-padding: 14;">
                                        <Label text="Selected Questions"
                                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                                        <Label text="Double-click Score to edit. Order is saved as shown."
                                               style="-fx-text-fill: #64748b;"/>
                                        <TableView fx:id="selectedQuestionsTable" editable="true" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="selectedOrderColumn" text="#" prefWidth="38"/>
                                                <TableColumn fx:id="selectedIdColumn" text="ID" prefWidth="48"/>
                                                <TableColumn fx:id="selectedContentColumn" text="Content" prefWidth="250"/>
                                                <TableColumn fx:id="selectedVersionColumn" text="Ver." prefWidth="48"/>
                                                <TableColumn fx:id="selectedScoreColumn" text="Score" prefWidth="70" editable="true"/>
                                            </columns>
                                        </TableView>
                                        <HBox spacing="7">
                                            <Button fx:id="removeButton" text="Remove" onAction="#handleRemoveQuestion"/>
                                            <Button fx:id="moveUpButton" text="Move Up" onAction="#handleMoveUp"/>
                                            <Button fx:id="moveDownButton" text="Move Down" onAction="#handleMoveDown"/>
                                        </HBox>
                                        <Separator/>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label text="Total:" style="-fx-font-weight: bold;"/>
                                            <Label fx:id="totalScoreLabel" text="0 / 100"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="totalFeedbackLabel" text="Total must equal exactly 100"/>
                                        </HBox>
                                    </VBox>
                                </items>
                            </SplitPane>
                            <VBox fx:id="questionIllustrationContainer" spacing="6"
                                  visible="false" managed="false">
                                <Label text="Selected question illustration"
                                       style="-fx-font-weight: bold;"/>
                                <ImageView fx:id="questionIllustrationView" fitWidth="520"
                                           fitHeight="320" preserveRatio="true"
                                           visible="false" managed="false"/>
                                <Label fx:id="questionIllustrationErrorLabel"
                                       text="Question illustration is unavailable"
                                       style="-fx-text-fill: #6b7280;"
                                       visible="false" managed="false"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>
